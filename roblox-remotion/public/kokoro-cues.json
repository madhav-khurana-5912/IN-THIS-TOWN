  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 3.004,
      "startFrame": 4,
      "endFrame": 90,
      "text": "In this town, say something angry, and it instantly comes true."
    },
    "b2": {
      "startSec": 3.064,
      "endSec": 5.512,
      "startFrame": 92,
      "endFrame": 165,
      "text": "Then a kid who could not control his temper lost his mind."
    },
    "b3": {
      "startSec": 5.572,
      "endSec": 9.049,
      "startFrame": 167,
      "endFrame": 271,
      "text": "My name is Theo, and my anger just signed my grandfather death certificate."
    },
    "b4": {
      "startSec": 9.109,
      "endSec": 12.929,
      "startFrame": 273,
      "endFrame": 388,
      "text": "It started after school when bullies soaked my backpack in mud and laughed in my face."
    },
    "b5": {
      "startSec": 13.009,
      "endSec": 16.645,
      "startFrame": 390,
      "endFrame": 499,
      "text": "I kicked open our front door, shaking with fury. The whole house went dead silent."
    },
    "b6": {
      "startSec": 16.705,
      "endSec": 20.29,
      "startFrame": 501,
      "endFrame": 609,
      "text": "Grandpa stood by the stove, quietly stirring dinner in his heavy welder gloves."
    },
    "b7": {
      "startSec": 20.35,
      "endSec": 23.053,
      "startFrame": 610,
      "endFrame": 692,
      "text": "He never takes them off. The fingertips are completely hollow."
    },
    "b8": {
      "startSec": 23.113,
      "endSec": 26.41,
      "startFrame": 693,
      "endFrame": 792,
      "text": "Decades ago, someone angrily screamed at him to cut off his own hands."
    },
    "b9": {
      "startSec": 26.49,
      "endSec": 30.484,
      "startFrame": 795,
      "endFrame": 915,
      "text": "Grandpa turned around, holding a burned pan. He had completely forgotten my birthday."
    },
    "b10": {
      "startSec": 30.564,
      "endSec": 33.214,
      "startFrame": 917,
      "endFrame": 996,
      "text": "Something inside me snapped. I gripped my fists and screamed:"
    },
    "w1": {
      "startSec": 33.334,
      "endSec": 33.752,
      "startFrame": 1000,
      "endFrame": 1013,
      "text": "I!"
    },
    "w2": {
      "startSec": 33.832,
      "endSec": 34.288,
      "startFrame": 1015,
      "endFrame": 1029,
      "text": "WISH!"
    },
    "w3": {
      "startSec": 34.368,
      "endSec": 34.83,
      "startFrame": 1031,
      "endFrame": 1045,
      "text": "YOU!"
    },
    "w4": {
      "startSec": 34.91,
      "endSec": 35.324,
      "startFrame": 1047,
      "endFrame": 1060,
      "text": "WERE!"
    },
    "w5": {
      "startSec": 35.404,
      "endSec": 35.896,
      "startFrame": 1062,
      "endFrame": 1077,
      "text": "GONE!"
    },
    "b11": {
      "startSec": 36.056,
      "endSec": 39.228,
      "startFrame": 1082,
      "endFrame": 1177,
      "text": "Grandpa did not even scream. He simply dissolved into thin air."
    },
    "b12": {
      "startSec": 39.308,
      "endSec": 42.651,
      "startFrame": 1179,
      "endFrame": 1280,
      "text": "His pan clattered against the floor, right in front of his empty rocking chair."
    },
    "b13": {
      "startSec": 42.751,
      "endSec": 46.418,
      "startFrame": 1283,
      "endFrame": 1393,
      "text": "And on the mantelpiece, our framed photo faded to show he died thirty years ago."
    }
  },
